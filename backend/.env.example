# PORT configuration (default: 5000)
PORT=5000

# MongoDB Production Connection String
# IMPORTANT: It MUST include the /edupulse database name before the ? query parameters.
# Never use the fallback database "test".
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@HOST/edupulse?retryWrites=true&w=majority

# JWT Secret for authentication
JWT_SECRET=your_jwt_secret_here
